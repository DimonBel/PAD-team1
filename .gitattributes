# Scripts and configs that run inside Linux containers keep LF endings, even on a Windows checkout
# with core.autocrlf=true. With CRLF, Postgres/Patroni fail with "/bin/sh^M: bad interpreter" or
# "exec entrypoint.sh: no such file or directory".
*.sh text eol=lf
db-replication/haproxy/haproxy.cfg text eol=lf
