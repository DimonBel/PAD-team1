#secrets for the shared compose file, copy to .env and fill in
#generate each one with: openssl rand -hex 32
#the names match docker-compose.yaml; compose refuses to start while a required one is missing

#shared by every service, they must sign the same tokens
JWT_SECRET=change_me
SERVICE_JWT_SECRET=change_me
#player-service's name for SERVICE_JWT_SECRET, set it to the same value
INTERNAL_JWT_SECRET=change_me
#the gateway sends this to every service as X-Gateway-Secret so they know the request came
#through it; services reject requests without it. The Gateway must get the same value
GATEWAY_SECRET=change_me
#Phoenix's own secret (session/cookie signing), shared by the Phoenix services
SECRET_KEY_BASE=change_me
#optional, the defaults match the services' own
PHX_HOST=localhost
PHX_SCHEME=http
JWT_TTL_MIN=60

#player-service database
PLAYER_POSTGRES_USER=player_service
PLAYER_POSTGRES_PASSWORD=change_me
PLAYER_POSTGRES_DB=player_service_dev
#optional
PLAYER_PHX_PORT=4000
PLAYER_HOST_PORT=4000
PLAYER_DB_HOST_PORT=5432
TRADE_TTL_SECONDS=600
IDEMPOTENCY_TTL_SECONDS=86400
DEV_TOKEN=change_me

#game-service database
GAME_POSTGRES_USER=game_service
GAME_POSTGRES_PASSWORD=change_me
GAME_POSTGRES_DB=game_service_prod
#the full URL game-service connects with, built from the three values above
GAME_DATABASE_URL=ecto://game_service:change_me@game-db:5432/game_service_prod
#optional
GAME_PORT=4000
GAME_HOST_PORT=4001
GAME_DB_HOST_PORT=5433
#game-service's own default (and the compose default) is true, which accepts unsigned
#requests; the shared stack has the real Player Service in it, so keep this false
BYPASS_AUTH=false
BYPASS_PLAYER_ID=11111111-1111-1111-1111-111111111111

#base-service database
BASE_DB_USER=base
BASE_DB_PASSWORD=change_me
BASE_DB_NAME=base_service

#crafting-service database
CRAFTING_DB_USER=crafting
CRAFTING_DB_PASSWORD=change_me
CRAFTING_DB_NAME=crafting_service

#world-service database
WORLD_POSTGRES_USER=world_service
WORLD_POSTGRES_PASSWORD=change_me
WORLD_POSTGRES_DB=world_service_dev
#optional
WORLD_PHX_PORT=4004
WORLD_HOST_PORT=4004
WORLD_DB_HOST_PORT=5434

#exam-service database
EXAM_POSTGRES_USER=exam_service
EXAM_POSTGRES_PASSWORD=change_me
EXAM_POSTGRES_DB=exam_service_dev
#optional
EXAM_PHX_PORT=4005
EXAM_HOST_PORT=4005
EXAM_DB_HOST_PORT=5435
#optional, where exam-service and world-service send their outbound calls
GATEWAY_URL=http://gateway:8080

#zombie-service database
ZOMBIE_DB_USER=zombie
ZOMBIE_DB_PASSWORD=change_me
ZOMBIE_DB_NAME=zombie_service

#resource-service database
RESOURCE_DB_USER=resource
RESOURCE_DB_PASSWORD=change_me
RESOURCE_DB_NAME=resource_service

#true while the other services are not up yet
MOCK_MODE=true
