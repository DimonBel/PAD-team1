#secrets for the shared compose file, copy to .env and fill in
#generate each one with: openssl rand -hex 32

#shared by every service, they must sign the same tokens
JWT_SECRET=change_me
SERVICE_JWT_SECRET=change_me

#player-service database
PLAYER_DB_USER=player
PLAYER_DB_PASSWORD=change_me
PLAYER_DB_NAME=player_service
#Phoenix's own secret, generate the same way as every other secret above
PLAYER_SECRET_KEY_BASE=change_me
#optional, the defaults match the service's own
PLAYER_JWT_TTL_MIN=60
PLAYER_TRADE_TTL_SECONDS=600
PLAYER_IDEMPOTENCY_TTL_SECONDS=86400

#game-service database
GAME_DB_USER=game
GAME_DB_PASSWORD=change_me
GAME_DB_NAME=game_service
#Phoenix's own secret, generate the same way as every other secret above
GAME_SECRET_KEY_BASE=change_me
#game-service's own default is true, which accepts unsigned requests; the shared
#stack has the real Player Service in it, so keep this false
GAME_BYPASS_AUTH=false

#base-service database
BASE_DB_USER=base
BASE_DB_PASSWORD=change_me
BASE_DB_NAME=base_service

#crafting-service database
CRAFTING_DB_USER=crafting
CRAFTING_DB_PASSWORD=change_me
CRAFTING_DB_NAME=crafting_service

#world-service database
WORLD_DB_USER=world
WORLD_DB_PASSWORD=change_me
WORLD_DB_NAME=world_service
#Phoenix's own secret (session/cookie signing) — generate it the same way as every other
#secret above: openssl rand -hex 32
WORLD_SECRET_KEY_BASE=change_me

#exam-service database
EXAM_DB_USER=exam
EXAM_DB_PASSWORD=change_me
EXAM_DB_NAME=exam_service
#Phoenix's own secret, generate the same way as WORLD_SECRET_KEY_BASE above
EXAM_SECRET_KEY_BASE=change_me

#zombie-service database
ZOMBIE_DB_USER=zombie
ZOMBIE_DB_PASSWORD=change_me
ZOMBIE_DB_NAME=zombie_service

ZOMBIE_API_PORT=4003
ZOMBIE_DB_PORT=5433

#resource-service database
RESOURCE_DB_USER=resource
RESOURCE_DB_PASSWORD=change_me
RESOURCE_DB_NAME=resource_service

RESOURCE_API_PORT=4006
RESOURCE_DB_PORT=5436

#true while the other services are not up yet
MOCK_MODE=true
