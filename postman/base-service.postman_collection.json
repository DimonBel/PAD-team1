{
  "info": {
    "name": "PAD-team1 / base-service",
    "description": "Every endpoint of base-service.\n\nSet `playerToken` and `serviceToken` first:\n\n    docker compose exec app bundle exec rake token:player\n    docker compose exec app bundle exec rake token:service\n\nRun the folders top to bottom with the Collection Runner. Requests capture `baseId`, `facilityId` and `decorationId` into collection variables, so later requests reuse them. `event_id` uses {{$guid}}, so re-running never replays an old idempotency record.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4007"
    },
    {
      "key": "playerToken",
      "value": ""
    },
    {
      "key": "serviceToken",
      "value": ""
    },
    {
      "key": "lobbyId",
      "value": "lobby-postman-001"
    },
    {
      "key": "baseId",
      "value": ""
    },
    {
      "key": "facilityId",
      "value": ""
    },
    {
      "key": "decorationId",
      "value": ""
    },
    {
      "key": "roomId",
      "value": "lab-a1"
    },
    {
      "key": "homeRoomId",
      "value": "faf-cab"
    },
    {
      "key": "playerId",
      "value": "player-uuid-123"
    }
  ],
  "item": [
    {
      "name": "00 Health",
      "description": "No auth required.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness plus database status."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('db up', () => pm.expect(pm.response.json().database).to.eql('up'));"
                ]
              }
            }
          ]
        }
      ]
    },
