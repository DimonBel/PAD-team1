{
  "info": {
    "name": "PAD-team1 / crafting-service",
    "description": "Crafting Service through the API Gateway, with a real player whose materials are in resource-service. Set jwt_secret and service_jwt_secret from the stack's .env, then run the whole collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "playerToken",
      "value": ""
    },
    {
      "key": "serviceToken",
      "value": ""
    },
    {
      "key": "playerId",
      "value": ""
    },
    {
      "key": "recipeId",
      "value": "barricade_kit"
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "timedRecipeId",
      "value": "energy_booster"
    },
    {
      "key": "timedJobId",
      "value": ""
    },
    {
      "key": "jwt_secret",
      "value": "change_me",
      "type": "string"
    },
    {
      "key": "service_jwt_secret",
      "value": "change_me",
      "type": "string"
    },
    {
      "key": "discovery_url",
      "value": "http://localhost:8500",
      "type": "string"
    },
    {
      "key": "run_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "stock_items",
      "value": "[]",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 Setup: a real player (player-service)",
      "item": [
        {
          "name": "Register a player",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/players/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"crafter_{{run_id}}\",\n  \"email\": \"crafter_{{run_id}}@faf.university\",\n  \"password\": \"crafterpass123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"playerId\", pm.response.json().player_id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "00 Health",
      "description": "No auth required.",
      "item": [
        {
          "name": "crafting-service is up in Service Discovery",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{discovery_url}}/services/crafting-service?status=up",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"at least one crafting-service instance is up\", () => {",
                  "    const body = pm.response.json();",
                  "    const instances = Array.isArray(body) ? body : body.instances;",
                  "    pm.expect(instances.length).to.be.above(0);",
                  "    instances.forEach((i) => pm.expect(i.status).to.eql(\"up\"));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Recipes",
      "description": "Moderator writes, open reads.",
      "item": [
        {
          "name": "List recipes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/crafting/recipes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "crafting",
                "recipes"
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "// What the player needs for every recipe, ten times over: stocked in resource-service next.",
                  "const recipes = pm.response.json();",
                  "const stock = {};",
                  "(Array.isArray(recipes) ? recipes : recipes.recipes).forEach((r) => (r.inputs || []).forEach((i) => { stock[i.item_id] = (stock[i.item_id] || 0) + i.count * 10; }));",
                  "pm.collectionVariables.set(\"stock_items\", JSON.stringify(Object.entries(stock).map(([item_id, count]) => ({ item_id, count }))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stock the player in resource-service",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/resources/entities/player/{{playerId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"stock-{{run_id}}\",\n  \"operation\": \"add\",\n  \"items\": {{stock_items}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{serviceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"the materials are in stock\", () => pm.expect(pm.response.json().length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "List recipes for a player",
          "request": {
            "method": "GET",
            "header": [
