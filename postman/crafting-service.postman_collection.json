  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// A run starts at \"Register a player\": a fresh run_id (unique usernames, lobbies, operation ids), and the ids",
          "// the previous run saved are forgotten, so two runs in a row never collide.",
          "if (pm.info.requestName === \"Register a player\" || !pm.collectionVariables.get(\"run_id\")) {",
          "    pm.collectionVariables.set(\"run_id\", Date.now().toString(36));",
          "    [\"playerId\", \"jobId\", \"timedJobId\"].forEach((key) => pm.collectionVariables.set(key, \"\"));",
          "}",
          "",
          "// Every request goes through the API Gateway (base url). The Gateway checks each token: HS256, signed",
          "// with JWT_SECRET (players) or SERVICE_JWT_SECRET (services, sub \"service:<name>\"). Put the stack's two",
          "// values from .env into the collection variables jwt_secret and service_jwt_secret.",
          "function base64url(wordArray) {",
          "    return CryptoJS.enc.Base64.stringify(wordArray).replace(/\\+/g, \"-\").replace(/\\//g, \"_\").replace(/=+$/, \"\");",
          "}",
          "function signJWT(payload, secret) {",
          "    const header = base64url(CryptoJS.enc.Utf8.parse(JSON.stringify({ alg: \"HS256\", typ: \"JWT\" })));",
          "    const body = base64url(CryptoJS.enc.Utf8.parse(JSON.stringify(payload)));",
          "    return header + \".\" + body + \".\" + base64url(CryptoJS.HmacSHA256(header + \".\" + body, secret));",
          "}",
          "const now = Math.floor(Date.now() / 1000);",
          "",
          "pm.collectionVariables.set(\"serviceToken\", signJWT({ sub: \"service:exam-service\", roles: [\"service\"], type: \"service\", iat: now, exp: now + 300 }, pm.variables.get(\"service_jwt_secret\")));",
          "pm.collectionVariables.set(\"playerToken\", signJWT({ sub: pm.collectionVariables.get(\"playerId\") || \"postman-moderator\", roles: [\"player\", \"moderator\"], type: \"player\", iat: now, exp: now + 3600 }, pm.variables.get(\"jwt_secret\")));"
        ]
      }
    }
  ]
