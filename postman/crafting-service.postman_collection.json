      "key": "playerToken",
      "value": ""
    },
    {
      "key": "serviceToken",
      "value": ""
    },
    {
      "key": "playerId",
      "value": "player-uuid-123"
    },
    {
      "key": "recipeId",
      "value": "barricade_kit"
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "timedRecipeId",
      "value": "energy_booster"
