          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player_id\": \"{{playerId}}\",\n  \"action_type\": \"chop_bench\",\n  \"target\": \"bench-room-A1\",\n  \"duration_seconds\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/game/lobbies/{{lobbyId}}/actions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "game", "lobbies", "{{lobbyId}}", "actions"]
            },
            "description": "duration_seconds is 10 here so the action finishes while you watch. Supported action_type values: chop_bench, scavenge_canteen, clear_room, barricade, repair_base, upgrade_base."
          }
        },
        {
          "name": "POST .../actions again - 409 already active",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('contract error text', () => pm.expect(pm.response.json().error).to.eql('Player already has an active action.'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player_id\": \"{{playerId}}\",\n  \"action_type\": \"barricade\",\n  \"target\": \"door-A2\",\n  \"duration_seconds\": 60\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/game/lobbies/{{lobbyId}}/actions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "game", "lobbies", "{{lobbyId}}", "actions"]
            },
            "description": "One action per player. Enforced by a partial unique index, so it is race-free."
          }
        },
        {
          "name": "GET .../actions/:action_id - poll",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('reports progress', () => pm.expect(body.percent).to.be.a('number'));",
                  "if (body.status === 'completed') {",
                  "  pm.test('reward came from Resource Service', () => pm.expect(body.reward).to.be.an('array'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/actions/{{actionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "actions", "{{actionId}}"]
            },
            "description": "Polling fallback for a dropped WebSocket. Run it again after ~10 seconds to see status flip to completed with the reward attached."
          }
        },
        {
          "name": "DELETE /api/game/actions/:action_id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 or 409 if it already finished', () => pm.expect(pm.response.code).to.be.oneOf([200, 409]));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/game/actions/{{actionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "game", "actions", "{{actionId}}"]
            }
          }
        }
      ]
    },
