            "url": {
              "raw": "{{baseUrl}}/api/game/lobbies/{{lobbyId}}/join",
              "host": ["{{baseUrl}}"],
              "path": ["api", "game", "lobbies", "{{lobbyId}}", "join"]
            }
          }
        },
