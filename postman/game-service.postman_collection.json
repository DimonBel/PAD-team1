            "url": "{{base_url}}/api/players/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"host_{{run_id}}\",\n  \"email\": \"host_{{run_id}}@faf.university\",\n  \"password\": \"hostpass123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
