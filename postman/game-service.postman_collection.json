    {
      "name": "5. Trade: game-service moves the items in resource-service",
      "item": [
        {
          "name": "POST trade 2 coffee-01 for 5 metal-01",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/game/lobbies/{{lobby_id}}/trades",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_player_id\": \"{{host_id}}\",\n  \"to_player_id\": \"{{guest_id}}\",\n  \"offer\": [\n    {\n      \"item_id\": \"coffee-01\",\n      \"count\": 2\n    }\n  ],\n  \"request\": [\n    {\n      \"item_id\": \"metal-01\",\n      \"count\": 5\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{host_jwt}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
