{
  "info": {
    "_postman_id": "8ad51113-343c-4d83-9f2c-cedf4f00195c",
    "name": "game-service",
    "description": "Game Service with Player, Resource and Zombie Service, through the API Gateway: two real players register and log in, play a lobby and a session, trade resources (checked in resource-service), lose XP to a zombie (checked in player-service) and end the semester. Set jwt_secret and service_jwt_secret from the stack's .env, then run the whole collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "game-service is up in Service Discovery",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{discovery_url}}/services/game-service?status=up",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"at least one game-service instance is up\", () => {",
                  "    const body = pm.response.json();",
                  "    const instances = Array.isArray(body) ? body : body.instances;",
                  "    pm.expect(instances.length).to.be.above(0);",
                  "    instances.forEach((i) => pm.expect(i.status).to.eql(\"up\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "player-service is up in Service Discovery",
          "request": {
