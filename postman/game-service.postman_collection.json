          "name": "POST .../join again - 409 ALREADY_JOINED",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('ALREADY_JOINED', () => pm.expect(pm.response.json().error).to.eql('ALREADY_JOINED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"player_id\": \"{{playerTwoId}}\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/game/lobbies/{{lobbyId}}/join",
              "host": ["{{baseUrl}}"],
              "path": ["api", "game", "lobbies", "{{lobbyId}}", "join"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Sessions",
      "item": [
        {
          "name": "POST /api/lobbies/:lobby_id/start",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('sessionId', body.session_id);",
                  "pm.test('starts on DAY 1', () => { pm.expect(body.cycle).to.eql('DAY'); pm.expect(body.cycle_number).to.eql(1); });",
                  "pm.test('map came from World Service', () => pm.expect(body.map_id).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cycle_duration_seconds\": 300,\n  \"semester_length_cycles\": 14\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/lobbies/{{lobbyId}}/start",
              "host": ["{{baseUrl}}"],
              "path": ["api", "lobbies", "{{lobbyId}}", "start"]
            },
            "description": "Host only. Pulls the map from World Service and the zombie configs from Zombie Service (both mocked), then starts the cycle timer.\n\nUse a small cycle_duration_seconds (for example 20) if you want to watch cycle_changed fire over the WebSocket."
          }
        },
        {
          "name": "GET /api/sessions/:session_id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('is running', () => pm.expect(body.status).to.eql('RUNNING'));",
                  "pm.test('reports zombies and players', () => { pm.expect(body.alive_zombies).to.be.a('number'); pm.expect(body.players).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}"]
            },
            "description": "The reconnect snapshot: what a client reads before the WebSocket takes over."
          }
        }
      ]
    },
    {
      "name": "3. Actions",
      "item": [
        {
          "name": "POST .../actions - start (202)",
          "event": [
