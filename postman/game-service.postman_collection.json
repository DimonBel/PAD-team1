{
  "info": {
    "_postman_id": "8f2b4a10-3d6e-4c21-9a77-1c0e5b6d9f01",
    "name": "PAD - Game Service",
    "description": "In Kahoots with the Undead - Game Service.\n\nImport this file into Postman, then run the folders top to bottom (or use the Collection Runner on the whole collection). Each request captures the ids it needs into collection variables, so nothing has to be pasted by hand.\n\nThe service ships with BYPASS_AUTH=true because Player Service does not exist yet, so the Authorization header is accepted as-is. Once Player Service is live, put a real token in the `token` variable and set BYPASS_AUTH=false; the collection keeps working unchanged.\n\nBase URL defaults to http://localhost:4002.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4002" },
    { "key": "token", "value": "dev-placeholder-token" },
    { "key": "serviceToken", "value": "dev-placeholder-service-token" },
    { "key": "playerId", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "playerTwoId", "value": "22222222-2222-2222-2222-222222222222" },
    { "key": "lobbyId", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "actionId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('database is up', () => pm.expect(pm.response.json().database).to.eql('up'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Liveness plus the number of live session processes. Also used by the docker-compose healthcheck."
          }
        }
      ]
    },
    {
      "name": "1. Lobbies",
      "item": [
        {
          "name": "POST /api/game/lobbies - create",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('lobbyId', body.lobby_id);",
                  "pm.test('host is the first player', () => pm.expect(body.players).to.include(body.host_id));",
                  "pm.test('starts on day 1', () => { pm.expect(body.day_cycle).to.eql(1); pm.expect(body.phase).to.eql('day'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"host_id\": \"{{playerId}}\",\n  \"university\": \"FAF\",\n  \"max_players\": 8,\n  \"name\": \"Cab Survivors\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/game/lobbies",
              "host": ["{{baseUrl}}"],
              "path": ["api", "game", "lobbies"]
            }
          }
        },
        {
          "name": "GET /api/game/lobbies - list",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/game/lobbies",
              "host": ["{{baseUrl}}"],
              "path": ["api", "game", "lobbies"]
            },
            "description": "Not in the contract; added so the seeded data is visible and the service is CRUD-complete."
          }
        },
        {
          "name": "GET /api/game/lobbies/:lobby_id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/game/lobbies/{{lobbyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "game", "lobbies", "{{lobbyId}}"]
            }
          }
        },
        {
          "name": "POST .../join - second player",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
