    {
      "name": "4. Unlock Flow",
      "item": [
        {
          "name": "Unlock New Section (service)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"unlocked with 2 generated rooms\", () => {",
                  "    pm.expect(json.unlocked).to.eql(true);",
                  "    pm.expect(json.rooms_added).to.have.lengthOf(2);",
                  "});",
                  "pm.collectionVariables.set(\"unlock_zone_id\", json.zone_id);",
                  "pm.collectionVariables.set(\"unlock_rooms\", JSON.stringify(json.rooms_added));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{service_token}}", "type": "string" }] },
            "body": {
              "mode": "raw",
              "raw": "{\"event_id\":\"evt-unlock-{{run_id}}\",\"player_id\":\"postman-player\",\"course_id\":\"{{course_id}}\",\"achievement_id\":\"survived_the_pumpkin\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/world/unlocks", "host": ["{{base_url}}"], "path": ["api", "world", "unlocks"] }
          },
          "response": []
        },
        {
          "name": "Replay same event_id (must not duplicate rooms)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"same zone and rooms as the first call\", () => {",
                  "    pm.expect(json.zone_id).to.eql(pm.collectionVariables.get(\"unlock_zone_id\"));",
                  "    pm.expect(JSON.stringify(json.rooms_added)).to.eql(pm.collectionVariables.get(\"unlock_rooms\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{service_token}}", "type": "string" }] },
            "body": {
              "mode": "raw",
              "raw": "{\"event_id\":\"evt-unlock-{{run_id}}\",\"player_id\":\"postman-player\",\"course_id\":\"totally-different-course\",\"achievement_id\":\"other\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/world/unlocks", "host": ["{{base_url}}"], "path": ["api", "world", "unlocks"] }
          },
          "response": []
        },
        {
          "name": "Confirm room count did not grow (still 2)",
