            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation_id\": \"xp-{{run_id}}\",\n  \"delta\": 250,\n  \"reason\": \"EXAM_PASSED\",\n  \"source_service\": \"exam-service\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{service_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"still level 2 with 50 XP\", () => { pm.expect(pm.response.json().level).to.eql(2); pm.expect(pm.response.json().xp).to.eql(50); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH XP with a player token -> refused",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/players/{{player_id}}/xp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation_id\": \"xp-self-{{run_id}}\",\n  \"delta\": 1000,\n  \"reason\": \"CHEAT\",\n  \"source_service\": \"player\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
