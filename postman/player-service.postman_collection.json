          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"level 2, 50 XP\", () => { pm.expect(pm.response.json().level).to.eql(2); pm.expect(pm.response.json().xp).to.eql(50); });"
                ]
