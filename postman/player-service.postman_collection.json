            "url": {"raw": "{{base_url}}/api/players/{{player_id}}/friends/{{friendship_id}}", "host": ["{{base_url}}"], "path": ["api", "players", "{{player_id}}", "friends", "{{friendship_id}}"]}
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('status 204', () => pm.response.to.have.status(204));"]}}]
        }
      ]
    },
    {
      "name": "Trades",
      "item": [
        {
          "name": "POST /api/trades (open trade — needs item to offer)",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"from_player_id\":\"{{player_id}}\",\"to_player_id\":\"{{player2_id}}\",\"offered_items\":[{\"item_id\":\"{{item_id}}\",\"quantity\":1}],\"requested_items\":[{\"code\":\"ENERGY_DRINK\",\"quantity\":1}]}"},
            "url": {"raw": "{{base_url}}/api/trades", "host": ["{{base_url}}"], "path": ["api", "trades"]}
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('status 201', () => pm.response.to.have.status(201));", "const b = pm.response.json(); pm.collectionVariables.set('trade_id', b.trade_id);"]}}]
        },
        {
          "name": "GET /api/trades?player_id&status=PENDING",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt}}"}],
            "url": {"raw": "{{base_url}}/api/trades?player_id={{player_id}}&status=pending", "host": ["{{base_url}}"], "path": ["api", "trades"], "query": [{"key": "player_id", "value": "{{player_id}}"}, {"key": "status", "value": "pending"}]}
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "const b = pm.response.json(); pm.expect(b.trades.length).to.be.above(0);"]}}]
        },
        {
          "name": "POST /api/trades/{trade_id}/reject (cancels + unlocks)",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{}"},
            "url": {"raw": "{{base_url}}/api/trades/{{trade_id}}/reject", "host": ["{{base_url}}"], "path": ["api", "trades", "{{trade_id}}", "reject"]}
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('rejected');"]}}]
        }
      ]
    },
