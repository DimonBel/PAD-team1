{
  "info": {
    "_postman_id": "26b62085-df78-4a11-8fa8-e3bb5c8f3fc1",
    "name": "player-service",
    "description": "Player Service through the API Gateway: accounts, login (the Gateway signs the JWT), profile, XP, inventory, friends, trades and logout. Set jwt_secret and service_jwt_secret from the stack's .env, then run the whole collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "player-service is up in Service Discovery",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{discovery_url}}/services/player-service?status=up",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"at least one player-service instance is up\", () => {",
                  "    const body = pm.response.json();",
                  "    const instances = Array.isArray(body) ? body : body.instances;",
                  "    pm.expect(instances.length).to.be.above(0);",
                  "    instances.forEach((i) => pm.expect(i.status).to.eql(\"up\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/health through the Gateway",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Register and log in",
      "item": [
        {
          "name": "Register Alice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/players/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice_{{run_id}}\",\n  \"email\": \"alice_{{run_id}}@faf.university\",\n  \"password\": \"alicepass123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"answers the new player at level 1 with 0 XP\", () => { pm.expect(body.player_id).to.be.a(\"string\"); pm.expect(body.level).to.eql(1); pm.expect(body.xp).to.eql(0); });",
                  "pm.collectionVariables.set(\"player_id\", body.player_id);"
                ]
              }
            }
          ]
        },
