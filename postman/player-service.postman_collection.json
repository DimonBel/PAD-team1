          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"refused: only a service JWT may award XP\", () => pm.expect(pm.response.code).to.be.oneOf([401, 403, 404]));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET XP: level 2, 50 XP",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/players/{{player_id}}/xp",
            "auth": {
              "type": "bearer",
              "bearer": [
