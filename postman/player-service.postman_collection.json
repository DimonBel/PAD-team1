                  "pm.test(\"levels up: level 2 with 50 XP into it\", () => { const b = pm.response.json(); pm.expect(b.level).to.eql(2); pm.expect(b.xp).to.eql(50); pm.expect(b.leveled_up).to.eql(true); });"
                ]
              }
            }
          ]
