  },
  {
   "id": "05-sagas-t-51",
   "angle": 0,
   "groupIds": [
    "05-sagas-g14"
   ],
   "frameId": null,
   "seed": 166756489,
   "version": 1,
   "versionNonce": 167081320,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "roughness": 0,
   "opacity": 100,
   "type": "text",
   "x": 1264,
   "y": 476.125,
   "width": 372.06000000000023,
   "height": 97.5,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roundness": null,
   "text": "Before: game-service called player-service, then wrote its own\ndatabase. If that write failed, the XP was gone for good, and a\nfailed XP push at session end was only logged.\nNow both changes happen, or the done ones are undone.\nNo lock is held across services while one of them is down,\nwhich a two-phase commit would need.",
   "originalText": "Before: game-service called player-service, then wrote its own\ndatabase. If that write failed, the XP was gone for good, and a\nfailed XP push at session end was only logged.\nNow both changes happen, or the done ones are undone.\nNo lock is held across services while one of them is down,\nwhich a two-phase commit would need.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
