   "roundness": null,
   "text": "Why a saga here",
   "originalText": "Why a saga here",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
