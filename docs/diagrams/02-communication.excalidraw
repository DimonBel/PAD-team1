  {
   "id": "02-communica-t-10",
   "angle": 0,
   "groupIds": [
    "02-communica-g2"
   ],
   "frameId": null,
   "seed": 174348591,
   "version": 1,
   "versionNonce": 174173390,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "roughness": 0,
   "opacity": 100,
   "type": "text",
   "x": 334,
   "y": 209.25,
   "width": 266.5000000000001,
   "height": 146.25,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roundness": null,
   "text": "1  verify the JWT (signature, expiry)\n2  read the session gw:session:<jti> in Redis\n     revoked \u2192 401 SESSION_REVOKED\n3  look the route up in config/routes.json\n     service-only (internal) route \u2192 404\n4  cacheable GET? look it up in Redis\n     HIT \u2192 answer at once (X-Cache: HIT)\n5  forward: X-Broker-Service, service JWT,\n     X-Player-Id, X-Roles, X-Request-Id",
   "originalText": "1  verify the JWT (signature, expiry)\n2  read the session gw:session:<jti> in Redis\n     revoked \u2192 401 SESSION_REVOKED\n3  look the route up in config/routes.json\n     service-only (internal) route \u2192 404\n4  cacheable GET? look it up in Redis\n     HIT \u2192 answer at once (X-Cache: HIT)\n5  forward: X-Broker-Service, service JWT,\n     X-Player-Id, X-Roles, X-Request-Id",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
